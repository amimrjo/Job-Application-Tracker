# Copy to .env for local testing (never commit the real .env)

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

NOTION_TOKEN=
# Either set an existing database id directly...
NOTION_DATABASE_ID=
# ...or give a parent page id and let the app create the database on first run
NOTION_PARENT_PAGE_ID=

# How many days back to scan. Use 14 for the first backfill run, 1 for daily.
DAYS_BACK=1
